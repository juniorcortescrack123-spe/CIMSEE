# Copie este archivo como ".env" (en esta misma carpeta) y complete los datos para que el sistema
# envie por correo las claves temporales. Si no lo configura, el sistema funciona igual y le muestra
# la clave temporal al administrador para entregarla en persona.

# Ejemplo con Gmail (use una "contrasena de aplicacion", no la contrasena normal de la cuenta)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=correo.de.la.empresa@gmail.com
MAIL_PASS=contrasena-de-aplicacion
MAIL_FROM=correo.de.la.empresa@gmail.com

# Direccion del sistema que aparece en el correo
APP_URL=http://localhost:5173

# Dias que tiene el usuario para cambiar la clave temporal
CLAVE_DIAS_VIGENCIA=3

# --- Solo para el despliegue en la nube (docker-compose.prod.yml) ---
DB_USER=cimse_user
DB_PASS=cambie-esta-contrasena
